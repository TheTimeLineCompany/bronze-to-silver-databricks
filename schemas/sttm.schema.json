{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-to-target mapping (STTM) for one source system",
  "type": "object",
  "required": [
    "source_id",
    "source_system",
    "version",
    "status",
    "owner",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}_[a-z0-9_]+$"
    },
    "source_system": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved"
      ]
    },
    "owner": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": [
        "target_table",
        "business_object",
        "data_class",
        "target_kind",
        "grain",
        "load_pattern",
        "scd_type",
        "primary_key",
        "business_key",
        "sources",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "target_table": {
          "type": "string"
        },
        "business_object": {
          "type": "string"
        },
        "data_class": {
          "enum": [
            "master",
            "reference",
            "event",
            "agreement",
            "measure",
            "snapshot",
            "bridge"
          ]
        },
        "target_kind": {
          "enum": [
            "master",
            "process"
          ]
        },
        "conformed_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "grain": {
          "type": "string",
          "minLength": 10
        },
        "load_pattern": {
          "enum": [
            "append",
            "merge",
            "scd2",
            "overwrite"
          ]
        },
        "scd_type": {
          "enum": [
            0,
            1,
            2,
            null
          ]
        },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "business_key": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "surrogate_key": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "column",
            "method",
            "of"
          ],
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "method": {
              "enum": [
                "hash",
                "sequence"
              ]
            },
            "of": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "partition_by": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "joins": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/join"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "table",
        "alias"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_]+\\.[a-zA-Z0-9_]+\\.[a-zA-Z0-9_]+$"
        },
        "alias": {
          "type": "string"
        },
        "filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "dedup": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_override": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 10
            },
            "approved_by": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "use a bronze table that discovery marked out_of_scope or derive_instead; the reason is reviewed in the PR"
        }
      }
    },
    "join": {
      "type": "object",
      "required": [
        "left",
        "right",
        "condition",
        "type",
        "cardinality"
      ],
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "type": {
          "enum": [
            "inner",
            "left",
            "right",
            "full"
          ]
        },
        "cardinality": {
          "enum": [
            "1:1",
            "1:N",
            "N:1",
            "N:M"
          ]
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "target",
        "type",
        "nullable",
        "rule",
        "key_role",
        "description",
        "provenance",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "rule": {
          "enum": [
            "direct",
            "normalised_key",
            "derived",
            "lookup",
            "constant",
            "technical"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "business_logic": {
          "type": "boolean"
        },
        "key_role": {
          "enum": [
            "PK",
            "BK",
            "FK",
            "PK_FK",
            "none"
          ]
        },
        "fk": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "column",
            "cardinality"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "entity"
              ]
            },
            {
              "required": [
                "table"
              ]
            }
          ],
          "properties": {
            "entity": {
              "type": "string",
              "description": "shared master entity in registry/entities.yaml"
            },
            "table": {
              "type": "string",
              "description": "target_table in the SAME STTM (process-to-process FK, e.g. line -> header)"
            },
            "column": {
              "type": "string",
              "description": "surrogate key column of the referenced table"
            },
            "cardinality": {
              "enum": [
                "1:1",
                "N:1"
              ]
            },
            "orphan_policy": {
              "enum": [
                "reject",
                "unknown_member",
                "allow_null"
              ]
            },
            "lookup_on": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 1,
              "description": "one item per business-key column of the referenced table, in order",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "expr"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "expr": {
                        "type": "string"
                      },
                      "key_rule": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "dq": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "minLength": 3
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "doc": {
              "type": [
                "string",
                "null"
              ]
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "profiling": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "pattern": "^E-[0-9]{4}$"
              }
            }
          },
          "additionalProperties": false
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "open_question": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q-[0-9]{4}$"
        },
        "business_rule": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^BR-[A-Z]+-[0-9]{3}$"
        },
        "privacy": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "class",
            "handling"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "enum": [
                "personal",
                "sensitive_personal",
                "financial",
                "secret"
              ]
            },
            "handling": {
              "enum": [
                "keep_tagged",
                "mask",
                "hash"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "required when the column comes from a bronze column that discovery classed as personal_data (column_scope.csv)"
        },
        "scope_override": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 10
            },
            "approved_by": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "map a bronze column that discovery marked out_of_scope; reviewed in the PR"
        }
      }
    }
  }
}