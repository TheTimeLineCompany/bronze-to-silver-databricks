# Example CODEOWNERS. Copy to .github/CODEOWNERS and replace the @client/... teams with your own.
# The framework is changed only by its maintainers; workers send contribution packages instead of commits.

*                                 @client/framework-maintainers
/registry_template/               @client/data-architects
/standards/                       @client/standards-owners
/lib/                             @client/engineering-leads
/plugins/                         @client/framework-maintainers
/AGENTS.md                        @client/framework-maintainers
/rules/                           @client/framework-maintainers
/.github/                         @client/framework-maintainers
